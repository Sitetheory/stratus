{
  "extends": "stylelint-config-standard",
  "rules": {
    "no-descending-specificity": null,
    "rule-empty-line-before": [
      "never-multi-line",
      {
        "ignore": [
          "after-comment"
        ]
      }
    ],
    "selector-type-no-unknown": [
      true,
      {
        "ignore": [
          "custom-elements"
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "packages/idx/src/property/search.filters.shared.less"
      ],
      "rules": {
        "function-no-unknown": [
          true,
          {
            "ignoreFunctions": [
              "fade"
            ]
          }
        ],
        "media-feature-range-notation": "prefix"
      }
    }
  ]
}
